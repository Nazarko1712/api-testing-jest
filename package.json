{
  "name": "api-testing-jest",
  "version": "1.0.0",
  "private": true,
  "description": "Jest + Pactum API suite with AJV schema validation, an authorization matrix and per-run generated test data",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "jest",
    "test:auth": "jest tests/auth",
    "test:bookings": "jest tests/bookings",
    "test:contract": "jest tests/contract",
    "test:serial": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "coverage": "jest --coverage"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "pactum": "^3.7.6",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
